# Configuration TechPulse AI

# Environnement
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_NAME=TechPulse AI
APP_TAGLINE="Toute l'actualité technologique importante, expliquée par l'IA, directement dans votre boîte mail."

# Intelligence Artificielle (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Base de données
DB_PATH=./data/techpulse.db

# Envoi d'emails
# Modes possibles: sandbox (simule et enregistre en local sans envoyer), smtp, resend
EMAIL_PROVIDER=sandbox
EMAIL_FROM="TechPulse AI <newsletter@techpulse.ai>"

# Configuration SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Configuration Resend (si EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Fuseau horaire
TIMEZONE=Europe/Paris

# Horaires de préparation et d'envoi (format cron ou heure HH:mm)
# Matin : préparation 05:00, envoi 06:15
SCHEDULE_MORNING_PREP="0 5 * * *"
SCHEDULE_MORNING_SEND="15 6 * * *"

# Après-midi : préparation 15:45, envoi 16:30
SCHEDULE_AFTERNOON_PREP="45 15 * * *"
SCHEDULE_AFTERNOON_SEND="30 16 * * *"
